{
    "scopeName": "nix.embedded.injection",
    "injectionSelector": "L:string.quoted.other.nix",
    "patterns": [
        { "include": "#bash-block" },
        { "include": "#python-block" },
        { "include": "#ruby-block" },
        { "include": "#json-block" },
        { "include": "#toml-block" },
        { "include": "#yaml-block" },
        { "include": "#html-block" },
        { "include": "#xml-block" },
        { "include": "#css-block" },
        { "include": "#sql-block" },
        { "include": "#lua-block" },
        { "include": "#javascript-block" },
        { "include": "#ini-block" },
        { "include": "#perl-block" }
    ],
    "repository": {
        "bash-block": {
            "begin": "#\\s*bash\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.shellscript",
            "patterns": [{ "include": "source.shell" }]
        },
        "python-block": {
            "begin": "#\\s*python\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.python",
            "patterns": [{ "include": "source.python" }]
        },
        "json-block": {
            "begin": "#\\s*json\\s*$",
