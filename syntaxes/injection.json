{
    "scopeName": "nix.embedded.injection",
    "injectionSelector": "L:string.quoted.other.nix",
    "patterns": [
        { "include": "#bash-block" },
        { "include": "#python-block" },
        { "include": "#json-block" },
        { "include": "#yaml-block" },
        { "include": "#html-block" },
        { "include": "#xml-block" },
        { "include": "#css-block" }
    ],
    "repository": {
        "bash-block": {
            "begin": "#\\s*bash\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.shellscript",
            "patterns": [{ "include": "source.shell" }]
        },
        "python-block": {
            "begin": "#\\s*python\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.python",
            "patterns": [{ "include": "source.python" }]
        },
        "json-block": {
            "begin": "#\\s*json\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.json",
            "patterns": [{ "include": "source.json" }]
        },
        "yaml-block": {
            "begin": "#\\s*yaml\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.yaml",
            "patterns": [{ "include": "source.yaml" }]
        },
        "html-block": {
            "begin": "(#\\s*html|<!--\\s*html\\s*-->)\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.html",
            "patterns": [{ "include": "text.html.basic" }]
        },
        "xml-block": {
            "begin": "(#\\s*xml|<!--\\s*xml\\s*-->)\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.xml",
            "patterns": [{ "include": "text.xml" }]
        },
        "css-block": {
            "begin": "(#\\s*css|/\\*\\s*css\\s*\\*/)\\s*$",
            "while": "^(?!.*''(?![\\$'\\\\]))",
            "beginCaptures": {
                "0": { "name": "comment.line.injection-tag.nix" }
            },
            "contentName": "meta.embedded.block.css",
            "patterns": [{ "include": "source.css" }]
        }
    }
}
